# IA da Mine — provedor principal (OpenRouter). Nunca commitar a chave real.
OPENROUTER_API_KEY=cole-sua-chave-openrouter-aqui
# Multiplas chaves: separe por virgula. Em 429/402/401 a Mine gira a chave e
# coloca a anterior em pausa. Chaves da mesma conta podem compartilhar cota.
# OPENROUTER_API_KEYS=chave-projeto-1,chave-projeto-2

# Reservas gratuitas independentes. Crie as chaves nos paineis oficiais do
# Google AI Studio e do GroqCloud; elas nunca sao enviadas ao navegador.
# GOOGLE_GEMINI_API_KEY=cole-sua-chave-google-ai-studio-aqui
# GOOGLE_GEMINI_API_KEYS=chave-projeto-1,chave-projeto-2
# GROQ_API_KEY=cole-sua-chave-groq-aqui
# GROQ_API_KEYS=chave-projeto-1,chave-projeto-2
# MINE_GEMINI_MODEL=gemini-3.6-flash
# MINE_GROQ_MODEL=openai/gpt-oss-120b

# Rede de seguranca: usada só quando o OpenRouter falha ou fica sem cota.
NVIDIA_API_KEY=cole-sua-chave-nvidia-aqui
# NVIDIA_API_KEYS=chave-projeto-1,chave-projeto-2

# Pesquisa na web: "on" liga o botão no chat. É COBRADA por resultado — o modelo
# ser :free não torna a busca gratuita. Sem esta variável, a busca fica desligada
# e o botão nem aparece na interface.
# MINE_WEB_SEARCH=on
# MINE_WEB_SEARCH_MAX_RESULTS=3

# Opcionais da IA
# AI_TIMEOUT_MS=45000
# MINE_MAX_OUTPUT_TOKENS=1024
# MINE_TOTAL_BUDGET_MS=55000
# MINE_RATE_PER_MINUTE=20
# MINE_RATE_PER_HOUR=120

ADMIN_ACCESS_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DATABASE_SSL=true
PUBLIC_APP_ORIGIN=https://seu-site.com
PORT=5174
