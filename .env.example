# IA da Mine — NanoGPT (API compatível com OpenAI). Nunca commitar a chave real.
# Crie a chave em https://nano-gpt.com/api
NANOGPT_API_KEY=cole-sua-chave-nanogpt-aqui
# Opcional: várias chaves separadas por vírgula, com rodízio automático.
# NANOGPT_API_KEYS=chave-1,chave-2

# Modelo principal (o único que o aluno vê como "Mine") e a reserva interna,
# usada quando o principal falha e para abrir os jogos depressa.
# NANOGPT_MODEL=openai/gpt-6-luna
# NANOGPT_FAST_MODEL=openai/gpt-5.4-mini
# MINE_REASONING_EFFORT=medium
# MINE_TASK_REASONING_EFFORT=low
# NANOGPT_BASE_URL=https://nano-gpt.com/api/v1

# Pesquisa na web: ligada sempre que há chave. Cada busca custa ~US$ 0,006
# (Linkup padrão). "off" desliga tudo e esconde o botão do globo.
# MINE_WEB_SEARCH=off
# Busca automática em perguntas sobre coisas recentes, sem precisar do botão.
# MINE_WEB_SEARCH_AUTO=off
# MINE_WEB_SEARCH_PROVIDER=linkup
# MINE_WEB_SEARCH_DEPTH=standard
# MINE_WEB_SEARCH_MAX_RESULTS=6

# Opcionais da IA
# AI_TIMEOUT_MS=45000
# MINE_MAX_OUTPUT_TOKENS=2600
# MINE_TOTAL_BUDGET_MS=55000
# MINE_RATE_PER_MINUTE=20
# MINE_RATE_PER_HOUR=120

ADMIN_ACCESS_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DATABASE_SSL=true
PUBLIC_APP_ORIGIN=https://minerva-liart.vercel.app
# Opcional: identifica a Minerva para Open Library e Crossref e libera o pool
# educado dessas APIs. Use um endereço monitorado; ele não vai para o navegador.
# PUBLIC_API_CONTACT_EMAIL=contato@seu-dominio.com
PORT=5174

# Ateliê: modelo de edição de imagem da NanoGPT para "Caprichar com a Mine" e teto diário por conta
ATELIE_IMAGE_MODEL=step-image-edit-2
ATELIE_IMAGE_FALLBACK_MODEL=pruna-ai/p-image/edit
ATELIE_DAILY_LIMIT=3

# Voz da Mine na aba Idiomas (NanoGPT /audio/speech, usa a mesma chave acima).
# MINE_TTS_MODEL=gpt-4o-mini-tts
# MINE_TTS_VOICE=coral
# MINE_VOICE_DAILY_LIMIT=400
