export type PerguntaDuelo = { pergunta: string; alternativas: string[]; correta: number; explicacao: string };
export type RespostaDuelo = { indice: number; escolha: number; ms: number; certo: boolean; pontos: number };
export type JogadorDuelo = { id: string; nome: string; pontos: number; respostas: RespostaDuelo[] };
export type ResultadoDuelo = "vitoria" | "empate" | "derrota";
export type EstadoDuelo = {
  codigo: string;
  tema: string;
  criadoEm: number;
  atualizadoEm: number;
  vistoEm: Record<string, number>;
  status: "sala" | "jogando" | "fim";
  contraMine: boolean;
  jogadores: JogadorDuelo[];
  perguntas: PerguntaDuelo[];
  atual: number;
  inicioPergunta: number;
  revelandoAte: number;
  abandono: string;
  quemSaiu?: string;
};
export type VistaDuelo = {
  codigo: string;
  tema: string;
  status: "sala" | "jogando" | "fim";
  contraMine: boolean;
  abandono: string;
  quemSaiu: string;
  atual: number;
  total: number;
  inicioPergunta: number;
  revelandoAte: number;
  agora: number;
  tempoPerguntaMs: number;
  euId: string;
  resultado: ResultadoDuelo | null;
  perguntas: Array<PerguntaDuelo | null>;
  jogadores: Array<{ id: string; nome: string; pontos: number; respondeu: boolean; eu: boolean; respostas: RespostaDuelo[] }>;
};

export const PERGUNTAS_POR_DUELO: number;
export const TEMPO_PERGUNTA_MS: number;
export const TEMPO_REVELACAO_MS: number;
export const CONTAGEM_MS: number;
export const SALA_EXPIRA_MS: number;
export const DUELO_PARADO_MS: number;
export const MINE_ID: string;
export function novoCodigo(aleatorio?: () => number): string;
export function codigoValido(valor: unknown): boolean;
export function pontosDaResposta(certo: boolean, ms: number): number;
export function jogadaDaMine(codigo: string, indice: number, correta: number): { ms: number; escolha: number };
export function limparPerguntas(lista: unknown, limite?: number): PerguntaDuelo[];
export function embaralharPergunta(pergunta: PerguntaDuelo, aleatorio?: () => number): PerguntaDuelo;
export function textoParaConferir(perguntas: PerguntaDuelo[]): string;
export function lerConferencia(texto: string, total: number): number[];
export function perguntasConferidas(perguntas: PerguntaDuelo[], respostas: number[]): PerguntaDuelo[];
export function criarDuelo(input: { codigo: string; tema: string; dono: { id: string; nome: string }; perguntas: PerguntaDuelo[]; contraMine?: boolean; agora?: number }): EstadoDuelo;
export function entrarNoDuelo(estado: EstadoDuelo, jogador: { id: string; nome: string }, agora?: number): { ok: boolean; erro?: string };
export function responder(estado: EstadoDuelo, jogadorId: string, indice: number, escolha: number, agora?: number): { ok: boolean; erro?: string };
export function avancar(estado: EstadoDuelo, agora?: number): EstadoDuelo;
export function abandonar(estado: EstadoDuelo, jogadorId: string, motivo?: string, agora?: number): void;
export function conferirSumico(estado: EstadoDuelo, agora?: number): void;
export function resultadoDe(estado: EstadoDuelo, jogadorId: string): ResultadoDuelo | null;
export function vistaDe(estado: EstadoDuelo, jogadorId: string, agora?: number): VistaDuelo;
